rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // [공통 함수]
    function isAuthenticated() {
      return request.auth != null;
    }

    // 차단 여부 확인
    function isBanned() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'banned';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "hodu@youshouyan.wiki" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // [유저 컬렉션]
    match /users/{userId} {
      allow read: if !isBanned(); 
      allow create: if request.auth != null || (userId in ["cxQPY2vEsmU3uyYX9mDYZ7aAPP22", "y4AmvZ3lxnOjHHPDEd24Wq2H6g13"]); 
      allow update: if (request.auth.token.email == "hodu@youshouyan.wiki") || isAdmin() || (request.auth != null && request.auth.uid == userId) || (userId in ["cxQPY2vEsmU3uyYX9mDYZ7aAPP22", "y4AmvZ3lxnOjHHPDEd24Wq2H6g13"]);
      allow delete: if (request.auth.token.email == "hodu@youshouyan.wiki") || isAdmin();
    }

    // [캐릭터 컬렉션]
    match /characters/{charId} {
      allow read: if !isBanned();
      allow write: if isAdmin();
    }

    // [카테고리]
    match /categories/{catId} {
      allow read: if !isBanned();
      allow write: if isAdmin();
    }

    // [공지사항]
    match /notices/{noticeId} {
      allow read: if !isBanned();
      allow write: if isAdmin();
    }
  }
}
